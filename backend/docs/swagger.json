            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    },
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Apply an rm or mv operation through the backup -\u003e write -\u003e audit pipeline. Requires state:write.",
