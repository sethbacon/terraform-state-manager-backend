# Production environment for docker-compose.prod.yml.
# Copy to .env.production, fill in every value, and NEVER commit the copy.

# =============================================================================
# Images (pin tags; never "latest" in production)
# =============================================================================
TSM_BACKEND_IMAGE=<registry>/terraform-state-manager-backend:v1.0.0
TSM_FRONTEND_IMAGE=<registry>/terraform-state-manager-frontend:v1.0.0

# =============================================================================
# Database
# =============================================================================
# Managed PostgreSQL recommended. With the bundled-db profile use host
# "postgres" and sslmode "disable".
TSM_DATABASE_HOST=<postgres-host>
TSM_DATABASE_PORT=5432
TSM_DATABASE_NAME=terraform_state_manager
TSM_DATABASE_USER=tsm
TSM_DATABASE_PASSWORD=<generate-strong-password>
TSM_DATABASE_SSL_MODE=require

# =============================================================================
# Server URLs
# =============================================================================
TSM_SERVER_HOST=0.0.0.0
TSM_SERVER_PORT=8080
# Browser-facing URL (your reverse proxy's public HTTPS hostname)
TSM_SERVER_PUBLIC_URL=https://tsm.yourdomain.com
TSM_SERVER_BASE_URL=https://tsm.yourdomain.com
# Must be reachable FROM CI RUNNERS (drift / version-lab result callbacks)
TSM_SERVER_CALLBACK_URL=https://tsm.yourdomain.com

# =============================================================================
# Security (REQUIRED — generate strong values)
# =============================================================================
# openssl rand -hex 32
TSM_JWT_SECRET=<generate-with-openssl-rand-hex-32>
# AES-256-GCM key: exactly 32 raw bytes OR 64 hex chars (openssl rand -hex 32).
# LOSING THIS KEY ORPHANS every stored source/CI credential — escrow it.
TSM_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# =============================================================================
# Authentication (enable the providers your IdP landscape needs)
# =============================================================================
TSM_AUTH_OIDC_ENABLED=false
# TSM_AUTH_OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# TSM_AUTH_OIDC_CLIENT_ID=<client-id>
# TSM_AUTH_OIDC_CLIENT_SECRET=<client-secret>
# TSM_AUTH_OIDC_REDIRECT_URL=https://tsm.yourdomain.com/api/v1/auth/callback
# TSM_AUTH_OIDC_GROUP_CLAIM_NAME=groups
# TSM_AUTH_OIDC_DEFAULT_ROLE=viewer

TSM_AUTH_LDAP_ENABLED=false
# TSM_AUTH_LDAP_HOST=ldap.yourdomain.com
# TSM_AUTH_LDAP_USE_TLS=true
# TSM_AUTH_LDAP_BASE_DN=dc=yourdomain,dc=com
# TSM_AUTH_LDAP_BIND_DN=cn=svc-tsm,ou=service,dc=yourdomain,dc=com
# TSM_AUTH_LDAP_BIND_PASSWORD=<bind-password>
# TSM_AUTH_LDAP_USER_FILTER=(sAMAccountName=%s)

TSM_AUTH_SAML_ENABLED=false
TSM_AUTH_MTLS_ENABLED=false
TSM_AUTH_SCIM_ENABLED=false

# =============================================================================
# Logging & Telemetry
# =============================================================================
TSM_LOGGING_LEVEL=warn
TSM_LOGGING_FORMAT=json
TSM_TELEMETRY_METRICS_ENABLED=true
TSM_TELEMETRY_METRICS_PROMETHEUS_PORT=9090
