# /etc/terraform-state-manager/environment — chmod 0600, owner root:tsm
TSM_SERVER_HOST=127.0.0.1
TSM_SERVER_PORT=8080
TSM_SERVER_PUBLIC_URL=https://tsm.yourdomain.com
TSM_SERVER_BASE_URL=https://tsm.yourdomain.com
TSM_SERVER_CALLBACK_URL=https://tsm.yourdomain.com

TSM_DATABASE_HOST=127.0.0.1
TSM_DATABASE_PORT=5432
TSM_DATABASE_NAME=terraform_state_manager
TSM_DATABASE_USER=tsm
TSM_DATABASE_PASSWORD=<generate-strong-password>
TSM_DATABASE_SSL_MODE=prefer

# openssl rand -hex 32 (both). ESCROW the encryption key.
TSM_JWT_SECRET=<openssl-rand-hex-32>
TSM_ENCRYPTION_KEY=<openssl-rand-hex-32>

TSM_LOGGING_LEVEL=info
TSM_LOGGING_FORMAT=json
DEV_MODE=false
# Single host runs the workers in-process.
TSM_WORKERS_ENABLED=true

# Directories a "local" state source may read state from (comma-separated
# absolute paths). Empty permits none, so set it if you use local sources.
#TSM_STATESOURCE_LOCAL_ROOTS=/var/lib/terraform-state-manager/states
