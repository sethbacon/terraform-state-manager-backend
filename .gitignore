# Go
backend/vendor/

# OS / editor
.DS_Store

# CI / test artifacts
# The release-PR guard writes the body it is grading into the workspace,
# one file per open pull request when the scheduled re-grade runs.
release-pr-body*.md
backend/coverage.out
# Produced by the coverage gate's own filter step (ci.yml runs
# `go run ./scripts/coverfilter`), so it appears for anyone who reproduces
# that gate locally -- it was the one sibling of coverage.out left untracked.
backend/coverage.filtered.out
backend/coverage.html
backend/gosec-results.json
backend/dist/
backend/bin/

# Node (CI tooling only, under .github/; the lockfile itself is tracked)
node_modules/
__pycache__/
